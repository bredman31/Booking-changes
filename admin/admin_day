  <script>
    // ================================
    // CONFIGURATION
    // ================================
    const firebaseConfig = {
      apiKey: "AIzaSyCVp4QDAnh5RcxGZIrEY2LriUWKQNcNbzE",
      authDomain: "cherry-tree-bookings.firebaseapp.com",
      databaseURL: "https://cherry-tree-bookings-default-rtdb.europe-west1.firebasedatabase.app",
      projectId: "cherry-tree-bookings",
      storageBucket: "cherry-tree-bookings.firebasestorage.app",
      messagingSenderId: "280166213685",
      appId: "1:280166213685:web:f80b11799f41f5f385297c"
    };
    
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();
    
    const WEBHOOK_URL = 'https://hook.eu2.make.com/p754q5eks857boisu6m3unr6qer6be4t';
    
    // Room configuration
    const rooms = [
      { id: '1', name: 'Room 1', class: 'room-1', dbValues: ['Room_1', '1', 'Room 1'] },
      { id: '2', name: 'Room 2', class: 'room-2', dbValues: ['Room_2', '2', 'Room 2'] },
      { id: '4', name: 'Room 4', class: 'room-4', dbValues: ['Room_4', '4', 'Room 4'] },
      { id: '5', name: 'Room 5', class: 'room-5', dbValues: ['Room_5', '5', 'Room 5'] },
      { id: '6', name: 'Room 6', class: 'room-6', dbValues: ['Room_6', '6', 'Room 6'] },
      { id: '7', name: 'Room 7', class: 'room-7', dbValues: ['Room_7', '7', 'Room 7'] },
      { id: '8', name: 'Room 8', class: 'room-8', dbValues: ['Room_8', '8', 'Room 8'] },
      { id: '9', name: 'Room 9', class: 'room-9', dbValues: ['Room_9', '9', 'Room 9'] },
      { id: 'online', name: 'Online', class: 'online', dbValues: ['Online', 'Online Counselling'] },
      { id: 'carpark', name: 'Car Park', class: 'car-park', dbValues: ['Car Park', 'Car_Park', '12'] }
    ];
    
    const ROOM_ID_MAPPING = {
      'Room_1': '3', 'Room_2': '7', 'Room_4': '8', 'Room_5': '13',
      'Room_6': '9', 'Room_7': '10', 'Room_8': '14', 'Room_9': '15',
      'Car Park': '12', 'Online': '11', 'Online Counselling': '11',
      'Henley_Holding_Room': '18'
    };
    
    const businessHours = [];
    for (let h = 8; h <= 20; h++) {
      businessHours.push(`${String(h).padStart(2, '0')}:00`);
    }
    
    // State
    let bookingData = [];
    let holdingRoomBookings = [];
    let currentDate = new Date().toISOString().split('T')[0];
    let selectedBooking = null;
    let isHoldingBooking = false;
    
    // ================================
    // INITIALIZATION
    // ================================
    document.addEventListener('DOMContentLoaded', () => {
      // Auth check disabled for testing
      sessionStorage.setItem('adminAuth', 'true');
      
      document.getElementById('dateSelector').value = currentDate;
      createCalendarGrid();
      loadBookingData();
      
      // Set up date change listener
      document.getElementById('dateSelector').addEventListener('change', (e) => {
        currentDate = e.target.value;
        populateCalendar();
      });
    });
    
    // ================================
    // CALENDAR GRID
    // ================================
    function createCalendarGrid() {
      const grid = document.getElementById('calendarGrid');
      grid.innerHTML = '';
      
      // Header row
      const timeHeader = document.createElement('div');
      timeHeader.className = 'grid-header';
      timeHeader.textContent = 'Time';
      grid.appendChild(timeHeader);
      
      rooms.forEach(room => {
        const header = document.createElement('div');
        header.className = `grid-header ${room.id === 'carpark' ? 'car-park' : ''}`;
        header.textContent = room.name;
        grid.appendChild(header);
      });
      
      // Time rows
      businessHours.forEach(time => {
        const timeCell = document.createElement('div');
        timeCell.className = 'time-header';
        timeCell.textContent = time;
        grid.appendChild(timeCell);
        
        rooms.forEach(room => {
          const cell = document.createElement('div');
          cell.className = `grid-cell ${room.id === 'carpark' ? 'car-park' : ''}`;
          cell.id = `cell-${room.id}-${time}`;
          cell.dataset.room = room.id;
          cell.dataset.time = time;
          grid.appendChild(cell);
        });
      });
    }
    
    // ================================
    // DATA LOADING
    // ================================
    async function loadBookingData() {
      const statusEl = document.getElementById('dataStatus');
      statusEl.textContent = 'Loading...';
      
      try {
        const snapshot = await database.ref('bookings').once('value');
        const data = snapshot.val() || [];
        const allBookings = Array.isArray(data) ? data : Object.values(data);
        
        // Filter active bookings
        const activeBookings = allBookings.filter(b => 
          b.status !== 'cancelled' && b.status !== 'cancel'
        );
        
        // Separate holding room
        holdingRoomBookings = activeBookings.filter(b => 
          b.room === 'Henley_Holding_Room' || b.room === '18' || b.date === '2030-01-01'
        );
        
        bookingData = activeBookings.filter(b => 
          b.room !== 'Henley_Holding_Room' && b.room !== '18' && b.date !== '2030-01-01'
        );
        
        updateHoldingCount();
        populateCalendar();
        
        statusEl.textContent = `${bookingData.length} bookings loaded`;
        setTimeout(() => { statusEl.textContent = ''; }, 3000);
        
        // Set up real-time listener
        database.ref('bookings').on('value', (snapshot) => {
          const data = snapshot.val() || [];
          const allBookings = Array.isArray(data) ? data : Object.values(data);
          const activeBookings = allBookings.filter(b => 
            b.status !== 'cancelled' && b.status !== 'cancel'
          );
          
          holdingRoomBookings = activeBookings.filter(b => 
            b.room === 'Henley_Holding_Room' || b.room === '18' || b.date === '2030-01-01'
          );
          
          bookingData = activeBookings.filter(b => 
            b.room !== 'Henley_Holding_Room' && b.room !== '18' && b.date !== '2030-01-01'
          );
          
          updateHoldingCount();
          populateCalendar();
        });
        
      } catch (error) {
        console.error('Error loading data:', error);
        statusEl.textContent = 'Error loading data';
      }
    }
    
    function refreshData() {
      loadBookingData();
    }
    
    function updateHoldingCount() {
      const countEl = document.getElementById('holdingCount');
      const btn = document.getElementById('holdingBtn');
      
      countEl.textContent = holdingRoomBookings.length;
      btn.disabled = holdingRoomBookings.length === 0;
    }
    
    // ================================
    // CALENDAR POPULATION
    // ================================
    function populateCalendar() {
      // Clear all cells
      document.querySelectorAll('.grid-cell').forEach(cell => {
        cell.innerHTML = '';
        cell.classList.remove('booked', 'selected', ...rooms.map(r => r.class));
        cell.onclick = null;
      });
      
      // Filter bookings for current date
      const dayBookings = bookingData.filter(b => b.date === currentDate);
      
      dayBookings.forEach(booking => {
        const room = getRoomConfig(booking);
        if (!room) return;
        
        const startHour = parseInt(booking.start.split(':')[0]);
        const endHour = parseInt(booking.end.split(':')[0]);
        
        for (let hour = startHour; hour < endHour; hour++) {
          if (hour >= 8 && hour <= 20) {
            const timeStr = `${String(hour).padStart(2, '0')}:00`;
            const cell = document.getElementById(`cell-${room.id}-${timeStr}`);
            
            if (cell) {
              cell.classList.add('booked', room.class);
              cell.innerHTML = `
                <div class="booking-content">
                  <div class="counsellor-name">${booking.client || 'Unknown'}</div>
                  <div class="booking-code">${booking.bookingId || booking.code || ''}</div>
                </div>
              `;
              
              cell.onclick = () => selectBooking(booking, room);
            }
          }
        }
      });
    }
    
    function getRoomConfig(booking) {
      for (const room of rooms) {
        if (room.dbValues.includes(booking.room)) {
          return room;
        }
        // Check for online in location
        if (room.id === 'online' && booking.location && 
            booking.location.toLowerCase().includes('online')) {
          return room;
        }
      }
      return null;
    }
    
    // ================================
    // BOOKING SELECTION
    // ================================
    function selectBooking(booking, room) {
      // Clear previous selection
      document.querySelectorAll('.grid-cell.selected').forEach(c => c.classList.remove('selected'));
      
      // Highlight selected cells
      const startHour = parseInt(booking.start.split(':')[0]);
      const endHour = parseInt(booking.end.split(':')[0]);
      
      for (let hour = startHour; hour < endHour; hour++) {
        const timeStr = `${String(hour).padStart(2, '0')}:00`;
        const cell = document.getElementById(`cell-${room.id}-${timeStr}`);
        if (cell) cell.classList.add('selected');
      }
      
      selectedBooking = booking;
      isHoldingBooking = false;
      showBookingForm(booking, room);
    }
    
    function selectHoldingBooking() {
      if (holdingRoomBookings.length === 0) return;
      
      // Get booking with lowest ID
      const booking = holdingRoomBookings.reduce((min, b) => {
        const currentId = parseInt(b.bookingId) || 999999;
        const minId = parseInt(min.bookingId) || 999999;
        return currentId < minId ? b : min;
      }, holdingRoomBookings[0]);
      
      selectedBooking = booking;
      isHoldingBooking = true;
      showHoldingForm(booking);
    }
    
    function showBookingForm(booking, room) {
      document.getElementById('noSelection').style.display = 'none';
      document.getElementById('bookingForm').style.display = 'block';
      
      document.getElementById('displayCounsellor').textContent = booking.client || '-';
      document.getElementById('displayCode').textContent = booking.bookingId || booking.code || '-';
      document.getElementById('displayRoom').textContent = room.name;
      document.getElementById('displayDate').textContent = booking.date;
      document.getElementById('displayTime').textContent = `${booking.start} - ${booking.end}`;
      
      if (booking.isPaid) {
        document.getElementById('paidRow').style.display = 'flex';
        document.getElementById('displayPaid').textContent = 'Paid';
        document.getElementById('displayPaid').style.color = '#28a745';
      } else {
        document.getElementById('paidRow').style.display = 'none';
      }
      
      // Reset form fields
      document.getElementById('newRoom').value = '';
      document.getElementById('newDate').value = '';
      document.getElementById('newTime').value = '';
      
      // Show cancel button for normal bookings
      document.getElementById('cancelBtn').style.display = 'block';
      document.getElementById('submitBtn').textContent = 'Submit Change';
      
      clearStatus();
    }
    
    function showHoldingForm(booking) {
      document.getElementById('noSelection').style.display = 'none';
      document.getElementById('bookingForm').style.display = 'block';
      
      document.getElementById('displayCounsellor').textContent = booking.client || '-';
      document.getElementById('displayCode').textContent = booking.bookingId || booking.code || '-';
      document.getElementById('displayRoom').textContent = 'Holding Room';
      document.getElementById('displayDate').textContent = 'N/A (Holding)';
      document.getElementById('displayTime').textContent = booking.start || '-';
      
      document.getElementById('paidRow').style.display = 'flex';
      document.getElementById('displayPaid').textContent = 'Paid (Credit Available)';
      document.getElementById('displayPaid').style.color = '#007bff';
      
      // Reset form fields
      document.getElementById('newRoom').value = '';
      document.getElementById('newDate').value = '';
      document.getElementById('newTime').value = '';
      
      // Hide cancel button for holding room bookings
      document.getElementById('cancelBtn').style.display = 'none';
      document.getElementById('submitBtn').textContent = 'Move from Holding Room';
      
      clearStatus();
    }
    
    // ================================
    // BOOKING MODIFICATION
    // ================================
    async function submitChange() {
      if (!selectedBooking) {
        showStatus('Please select a booking first', 'error');
        return;
      }
      
      const newRoom = document.getElementById('newRoom').value;
      const newDate = document.getElementById('newDate').value;
      const newTime = document.getElementById('newTime').value;
      
      if (isHoldingBooking) {
        if (!newRoom || !newDate || !newTime) {
          showStatus('Please select room, date and time for holding room booking', 'error');
          return;
        }
      } else {
        if (!newRoom && !newDate && !newTime) {
          showStatus('Please specify at least one change', 'error');
          return;
        }
      }
      
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Processing...';
      showStatus('Sending change request...', 'info');
      
      try {
        // Get counsellor ID
        const counsellorId = selectedBooking.clientId || await lookupCounsellorId(selectedBooking.client);
        
        if (!counsellorId) {
          throw new Error('Could not find counsellor ID');
        }
        
        // Build room values
        const originalRoom = isHoldingBooking ? 'Henley_Holding_Room' : convertRoomName(getRoomConfig(selectedBooking)?.name || selectedBooking.room);
        const requestedRoom = newRoom ? convertRoomName(newRoom) : originalRoom;
        
        const originalDate = isHoldingBooking ? '2030-01-01' : selectedBooking.date;
        const originalTime = selectedBooking.start;
        
        const payload = {
          timestamp: new Date().toISOString(),
          action: 'modify',
          counsellor_id: counsellorId,
          original_booking_code: selectedBooking.bookingId || selectedBooking.code,
          original_room: originalRoom,
          original_room_id: ROOM_ID_MAPPING[originalRoom] || '3',
          original_location_id: getLocationId(originalRoom),
          original_datetime: `${originalDate}T${originalTime}:00`,
          requested_room: requestedRoom,
          requested_room_id: ROOM_ID_MAPPING[requestedRoom] || '3',
          requested_location_id: getLocationId(requestedRoom),
          requested_datetime: `${newDate || originalDate}T${newTime || originalTime}:00`,
          service_id: '2',
          comments: selectedBooking.comments || '',
          is_paid: selectedBooking.isPaid ? 'True' : 'No',
          admin_override: 'true'
        };
        
        console.log('Webhook payload:', payload);
        
        const response = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        
        if (!response.ok) {
          throw new Error(`Server error: ${response.status}`);
        }
        
        showStatus('Change submitted successfully!', 'success');
        
        // Reset form after delay
        setTimeout(() => {
          resetForm();
          refreshData();
        }, 2000);
        
      } catch (error) {
        console.error('Submit error:', error);
        showStatus(`Error: ${error.message}`, 'error');
      }
      
      submitBtn.disabled = false;
      submitBtn.textContent = isHoldingBooking ? 'Move from Holding Room' : 'Submit Change';
    }
    
    async function cancelBooking() {
      if (!selectedBooking || isHoldingBooking) return;
      
      if (!confirm(`Cancel this booking?\n\nCounsellor: ${selectedBooking.client}\nDate: ${selectedBooking.date}\nTime: ${selectedBooking.start}\n\nThis cannot be undone.`)) {
        return;
      }
      
      const cancelBtn = document.getElementById('cancelBtn');
      cancelBtn.disabled = true;
      cancelBtn.textContent = 'Cancelling...';
      showStatus('Processing cancellation...', 'info');
      
      try {
        const counsellorId = selectedBooking.clientId || await lookupCounsellorId(selectedBooking.client);
        const room = getRoomConfig(selectedBooking);
        const roomName = convertRoomName(room?.name || selectedBooking.room);
        
        let payload;
        
        if (selectedBooking.isPaid) {
          // Move to holding room
          payload = {
            timestamp: new Date().toISOString(),
            action: 'modify',
            counsellor_id: counsellorId,
            original_booking_code: selectedBooking.bookingId || selectedBooking.code,
            original_room: roomName,
            original_room_id: ROOM_ID_MAPPING[roomName] || '3',
            original_location_id: getLocationId(roomName),
            original_datetime: `${selectedBooking.date}T${selectedBooking.start}:00`,
            requested_room: 'Henley_Holding_Room',
            requested_room_id: '18',
            requested_location_id: '2',
            requested_datetime: `2030-01-01T${selectedBooking.start}:00`,
            service_id: '2',
            comments: selectedBooking.comments || '',
            is_paid: 'True',
            admin_override: 'true'
          };
        } else {
          // Full cancellation
          payload = {
            timestamp: new Date().toISOString(),
            action: 'cancel',
            counsellor_id: counsellorId,
            booking_code: selectedBooking.bookingId || selectedBooking.code,
            original_datetime: `${selectedBooking.date}T${selectedBooking.start}:00`,
            original_room: roomName,
            service_id: '2',
            comments: selectedBooking.comments || '',
            is_paid: 'No',
            admin_override: 'true'
          };
        }
        
        const response = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        
        if (!response.ok) {
          throw new Error(`Server error: ${response.status}`);
        }
        
        showStatus(selectedBooking.isPaid ? 'Moved to holding room!' : 'Booking cancelled!', 'success');
        
        setTimeout(() => {
          resetForm();
          refreshData();
        }, 2000);
        
      } catch (error) {
        console.error('Cancel error:', error);
        showStatus(`Error: ${error.message}`, 'error');
      }
      
      cancelBtn.disabled = false;
      cancelBtn.textContent = 'Cancel Appointment';
    }
    
    // ================================
    // UTILITY FUNCTIONS
    // ================================
    function convertRoomName(name) {
      if (name && name.startsWith('Room ')) {
        return name.replace('Room ', 'Room_');
      }
      return name;
    }
    
    function getLocationId(roomName) {
      const onlineRooms = ['Online', 'Online Counselling'];
      return onlineRooms.includes(roomName) ? '1' : '2';
    }
    
    async function lookupCounsellorId(name) {
      // Check booking data first
      const booking = bookingData.find(b => b.client === name && b.clientId);
      if (booking) return booking.clientId;
      
      // Fallback mapping
      const mapping = { 'Barry Redman': '6' };
      return mapping[name] || null;
    }
    
    function showStatus(message, type) {
      const el = document.getElementById('statusMessage');
      el.textContent = message;
      el.className = `status-message ${type}`;
    }
    
    function clearStatus() {
      const el = document.getElementById('statusMessage');
      el.className = 'status-message';
      el.textContent = '';
    }
    
    function resetForm() {
      selectedBooking = null;
      isHoldingBooking = false;
      document.getElementById('noSelection').style.display = 'block';
      document.getElementById('bookingForm').style.display = 'none';
      document.querySelectorAll('.grid-cell.selected').forEach(c => c.classList.remove('selected'));
    }
    
    // ================================
    // NAVIGATION
    // ================================
    function changeDay(delta) {
      const date = new Date(currentDate + 'T12:00:00');
      date.setDate(date.getDate() + delta);
      currentDate = date.toISOString().split('T')[0];
      document.getElementById('dateSelector').value = currentDate;
      populateCalendar();
      resetForm();
    }
    
    function goToToday() {
      currentDate = new Date().toISOString().split('T')[0];
      document.getElementById('dateSelector').value = currentDate;
      populateCalendar();
      resetForm();
    }
  </script>
</body>
