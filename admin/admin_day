  </header>
  
  <div class="main-container">
    <div class="calendar-section">
      <!-- Legend -->
      <div class="legend">
        <div class="legend-item"><div class="legend-color room-1"></div>Room 1</div>
        <div class="legend-item"><div class="legend-color room-2"></div>Room 2</div>
        <div class="legend-item"><div class="legend-color room-4"></div>Room 4</div>
        <div class="legend-item"><div class="legend-color room-5"></div>Room 5</div>
        <div class="legend-item"><div class="legend-color room-6"></div>Room 6</div>
        <div class="legend-item"><div class="legend-color room-7"></div>Room 7</div>
        <div class="legend-item"><div class="legend-color room-8"></div>Room 8</div>
        <div class="legend-item"><div class="legend-color room-9"></div>Room 9</div>
